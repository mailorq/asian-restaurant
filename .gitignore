# secrets and local compose override
.env
.env.*
!.env.example
!.env.e2e
compose.override.yaml

# private keys / signing material — never commit (*.pem.example placeholders are not matched)
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ecdsa
ops/identity/*.pem

# python / django
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
backend/staticfiles/
backend/media/
*.log

# prometheus multiprocess dir
backend/.prometheus/

# node / vite
node_modules/
frontend/dist/
frontend/.vite/
frontend/.test-build/
*.tsbuildinfo
npm-debug.log*

# the optimized product photos seed the menu and are tracked against backend/seed/images.sha256
backend/seed/images/*
!backend/seed/images/optimized/
frontend/public/assets/menu-optimized/

# editors / os
.idea/
.vscode/
.DS_Store
Thumbs.db
